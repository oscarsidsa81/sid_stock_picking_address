<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_sid_direccion" model="ir.ui.view">
            <field name="name">stock.picking.form.sid.direccion</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="priority">160</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='is_return_picking']" position="before">
